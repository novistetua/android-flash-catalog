<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp">

            <HorizontalScrollView
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/pagerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/photo"
                        android:layout_width="300dp"
                        android:layout_height="match_parent"
                        android:background="#DDDDDD"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/pageHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="#99000000"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/btnAddExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋ Добавить фото в карточку"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnShareQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Передать эту карточку по QR"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/extraNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Дополнительные фото можно добавить после сохранения карточки. Кнопки ниже относятся к главному фото."
            android:textColor="#777777"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRotL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Влево 90°"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRotR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Вправо 90°"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRetake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Переснять"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обрезать вручную"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnEraser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Доработать фон и яркость кистью"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSharpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Повысить резкость: выкл"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCutout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Убрать фон (PNG): выкл"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Название (это имя папки)"
            android:textColor="#444444" />

        <EditText
            android:id="@+id/nameEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Аннотация"
            android:textColor="#444444" />

        <EditText
            android:id="@+id/noteEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Например: Тут OS для SBC, Debian"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Удалить"
            android:textColor="#C62828" />
    </LinearLayout>
</ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/dirtyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3CD"
            android:padding="8dp"
            android:text="Есть несохранённые изменения. Нажми «Сохранить», иначе они пропадут."
            android:textColor="#664D03"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить в каталог" />
    </LinearLayout>
</LinearLayout>
