<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обмен по QR"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Одно устройство показывает QR, другое сканирует. По Wi‑Fi передача идёт напрямую, а если устройства в разных сетях, через интернет-обменник. Данные шифруются, ключ есть только в QR."
            android:textColor="#555555"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Отправить: показать QR" />

        <CheckBox
            android:id="@+id/cbNet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Для другой сети: загрузить через интернет (зашифровано)"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbBrowser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Дать скачать и в браузере, без приложения (по Wi‑Fi, не зашифровано)"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnReceive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Получить: сканировать QR (любой способ)" />

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ссылка для браузера (Wi‑Fi / ZeroTier)" />

        <Button
            android:id="@+id/btnWebStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Остановить веб-сервер"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Через интернет: работает, даже если устройства в разных сетях или на мобильном интернете. Подходит и для обмена с компьютером, где установлен Magic Wormhole (команда wormhole receive)."
            android:textColor="#555555"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCrocSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Через интернет: отправить (код и QR)" />

        <Button
            android:id="@+id/btnCrocCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ввести код вручную" />

        <Button
            android:id="@+id/btnCrocShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Поделиться кодом (мессенджер)"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCrocCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Остановить обмен"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/qrView"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="#222222"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
